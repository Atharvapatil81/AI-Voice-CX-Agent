# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the model (must support tool calling on Groq)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_SUMMARY_MODEL=openai/gpt-oss-120b
# Models tried in order when the main one is rate-limited or unavailable
# GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Reasoning effort for gpt-oss models: low | medium | high
# GROQ_REASONING_EFFORT=low

# Optional: any OpenAI-compatible endpoint (defaults to Groq)
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: local port (default 3000)
# PORT=3000
